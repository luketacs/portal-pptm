{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/browser",
  "functions": {
    "api/apontamentos.js": { "maxDuration": 30 },
    "api/export-materials.js": { "maxDuration": 30 },
    "api/export-requests.js": { "maxDuration": 30 },
    "api/telegram-material-bot.js": { "maxDuration": 15 }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
