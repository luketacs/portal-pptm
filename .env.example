# Configuração exclusiva das funções api/. Copie para .env.local.
# A configuração pública Angular está em src/environments/.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Origens separadas por vírgula, sem espaços. Inclua localhost só no ambiente de desenvolvimento.
ALLOWED_ORIGINS=http://localhost:4200

# Integração de consulta de material no SIGMA, se o endpoint exigir token.
MATERIAL_API_TOKEN=

# Opcionais: somente para o bot de consulta de materiais no Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
